{
  "schema": "agenda-planner-fixtures/1",
  "classification": "synthetic",
  "notice": "Authored adversarial inputs and expected model outcomes, not participant observations.",
  "cases": [
    {
      "id": "overloaded-duration",
      "purpose": "65 mandatory minutes cannot fit 60; three tied, one-field, five-minute repairs preserve both tasks.",
      "agenda": {
        "schema": "agenda-planner/1", "title": "Five minutes over", "classification": "synthetic",
        "day": { "start": 540, "end": 600, "stepMinutes": 5, "availability": [[540, 610]] },
        "tasks": [
          { "id": "design", "label": "Design review", "duration": 35, "availability": [[540, 610]], "dependsOn": [], "fixedStart": null },
          { "id": "decision", "label": "Decision session", "duration": 30, "availability": [[540, 610]], "dependsOn": [], "fixedStart": null }
        ],
        "repairs": { "latestEnd": 610, "durationFloors": { "design": 30, "decision": 25 } }
      },
      "expected": { "status": "infeasible", "proofKind": "capacity", "coreSize": 2, "repairStatus": "minimum-proven", "cost": { "changedFields": 1, "totalMinutes": 5 }, "choices": 3 }
    },
    {
      "id": "disjoint-availability",
      "purpose": "Aggregate spare minutes do not justify splitting a nonpreemptive task.",
      "agenda": {
        "schema": "agenda-planner/1", "title": "A fragmented hour", "classification": "synthetic",
        "day": { "start": 540, "end": 600, "stepMinutes": 5, "availability": [[540, 555], [575, 600]] },
        "tasks": [
          { "id": "focus", "label": "Uninterrupted focus", "duration": 30, "availability": [[540, 600]], "dependsOn": [], "fixedStart": null }
        ],
        "repairs": { "latestEnd": 600, "durationFloors": { "focus": 25 } }
      },
      "expected": { "status": "infeasible", "proofKind": "empty-domain", "coreSize": 1, "repairStatus": "minimum-proven", "cost": { "changedFields": 1, "totalMinutes": 5 }, "choices": 1 }
    },
    {
      "id": "dependency-conflict",
      "purpose": "Both tasks fit separately, but the only time ordering contradicts their finish-to-start dependency.",
      "agenda": {
        "schema": "agenda-planner/1", "title": "Approval arrives too late", "classification": "synthetic",
        "day": { "start": 540, "end": 600, "stepMinutes": 5, "availability": [[540, 600]] },
        "tasks": [
          { "id": "approve", "label": "Approval", "duration": 20, "availability": [[570, 600]], "dependsOn": [], "fixedStart": null },
          { "id": "deliver", "label": "Delivery after approval", "duration": 20, "availability": [[540, 565]], "dependsOn": ["approve"], "fixedStart": null }
        ],
        "repairs": { "latestEnd": 600, "durationFloors": {} }
      },
      "expected": { "status": "infeasible", "proofKind": "exhaustive-search", "coreSize": 2, "repairStatus": "none-within-policy" }
    },
    {
      "id": "dependency-cycle",
      "purpose": "A positive-duration directed cycle is impossible, not malformed and not fixed by adding time.",
      "agenda": {
        "schema": "agenda-planner/1", "title": "Circular prerequisites", "classification": "synthetic",
        "day": { "start": 540, "end": 600, "stepMinutes": 5, "availability": [[540, 615]] },
        "tasks": [
          { "id": "alpha", "label": "Alpha", "duration": 10, "availability": [[540, 615]], "dependsOn": ["beta"], "fixedStart": null },
          { "id": "beta", "label": "Beta", "duration": 10, "availability": [[540, 615]], "dependsOn": ["alpha"], "fixedStart": null }
        ],
        "repairs": { "latestEnd": 615, "durationFloors": { "alpha": 5, "beta": 5 } }
      },
      "expected": { "status": "infeasible", "proofKind": "dependency-cycle", "coreSize": 2, "repairStatus": "none-within-policy" }
    },
    {
